package partials

import (
	"fmt"
	"net/url"
	"github.com/johnnygreco/beacon/internal/views"
	"github.com/johnnygreco/beacon/internal/views/components"
)

templ CompletedSessionListWithMore(sessions []views.SessionSummary, hasMore bool, rangeVal string, nextOffset int) {
	for _, s := range sessions {
		@components.CompletedSessionRow(s)
	}
	if hasMore {
		<tr hx-get={ fmt.Sprintf("/dashboard/sessions?range=%s&offset=%d", url.QueryEscape(rangeVal), nextOffset) }
		     hx-trigger="revealed"
		     hx-swap="outerHTML"
		     hx-on::before-request="this.closest('[id]').removeAttribute('sse-swap')"
		     class="text-center">
			<td colspan="10" class="py-3">
				<span class="text-xs text-gray-500">Loading more...</span>
			</td>
		</tr>
	}
	if len(sessions) == 0 && !hasMore {
		<tr>
			<td colspan="10" class="text-center py-4">
				<span class="text-sm text-gray-500">No completed sessions</span>
			</td>
		</tr>
	}
}
