package partials

import (
	"github.com/johnnygreco/beacon/internal/views"
	"github.com/johnnygreco/beacon/internal/views/components"
)

templ SessionConversation(chatTurns []views.ChatTurn, turns []views.TurnDetail) {
	@SessionConversationWithContext(chatTurns, turns, views.ChatContext{})
}

templ SessionConversationWithContext(chatTurns []views.ChatTurn, turns []views.TurnDetail, chatCtx views.ChatContext) {
	<div id="chat-view" class="transcript-chat-view">
		@components.ChatViewWithContext(chatTurns, chatCtx)
	</div>
	<div id="timeline-view" class="transcript-timeline-view hidden">
		@components.TurnTimeline(turns)
	</div>
	<script src="/static/js/transcript.js"></script>
}
