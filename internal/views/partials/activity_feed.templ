package partials

import (
	"fmt"
	"github.com/johnnygreco/beacon/internal/views"
)

templ ActivityTimelineFull(items []views.ActivityItem) {
	if len(items) > 0 {
		<div class="relative pl-8">
			<div class="absolute left-3 top-0 bottom-0 w-px bg-gray-700"></div>
			for _, item := range items {
				@activityItem(item)
			}
		</div>
	} else {
		<p class="text-sm text-gray-500 text-center py-4">No recent activity</p>
	}
}

templ activityItem(item views.ActivityItem) {
	<a href={ templ.SafeURL(fmt.Sprintf("/sessions/%s#%s", item.SessionID, item.ID)) }
	   data-type={ item.Type }
	   class="block relative py-2 pl-4 hover:bg-gray-800/50 rounded-lg transition-colors group">
		<div class={ "absolute left-[-8px] top-3.5 w-2.5 h-2.5 rounded-full ring-2 ring-gray-900", activityDotColor(item.Type) }></div>
		<p class="text-sm text-gray-300 group-hover:text-gray-100 transition-colors mb-1">{ item.Summary }</p>
		<div class="flex items-center gap-2">
			<span class={ "px-1.5 py-0.5 rounded text-xs flex-shrink-0", activityBadgeStyle(item.Type) }>{ activityLabel(item.Type) }</span>
			if item.SessionID != "" {
				<span class="text-xs text-gray-600 font-mono flex-shrink-0">{ views.TruncateID(item.SessionID) }</span>
			}
			<span class="text-xs text-gray-600 flex-shrink-0">{ views.RelativeTime(item.Timestamp) }</span>
		</div>
	</a>
}

func activityDotColor(eventType string) string {
	switch eventType {
	case "message":
		return "bg-blue-400"
	case "tool_call":
		return "bg-yellow-400"
	case "error":
		return "bg-red-400"
	case "session_meta":
		return "bg-teal-400"
	default:
		return "bg-gray-400"
	}
}

func activityLabel(eventType string) string {
	switch eventType {
	case "message":
		return "message"
	case "tool_call":
		return "tool"
	case "error":
		return "error"
	case "session_meta":
		return "session"
	default:
		return eventType
	}
}

func activityBadgeStyle(eventType string) string {
	switch eventType {
	case "message":
		return "bg-blue-500/15 text-blue-400"
	case "tool_call":
		return "bg-yellow-500/15 text-yellow-400"
	case "error":
		return "bg-red-500/15 text-red-400"
	case "session_meta":
		return "bg-teal-500/15 text-teal-400"
	default:
		return "bg-gray-600/40 text-gray-400"
	}
}
