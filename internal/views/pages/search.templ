package pages

import (
	"github.com/johnnygreco/beacon/internal/views"
	"github.com/johnnygreco/beacon/internal/views/components"
	"github.com/johnnygreco/beacon/internal/views/partials"
)

templ Search(results []views.SearchResult) {
	@views.Layout("Search") {
		<script>document.body.setAttribute('data-page', 'search');</script>
		<div id="search-wrap" class="search-page">
			<section class="search-header" aria-labelledby="search-title">
				<div class="search-topbar">
					<a href="/" class="search-back-link" aria-label="Back to dashboard">
						<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
						</svg>
						Dashboard
					</a>
					<span class="search-key-hint" aria-hidden="true">/</span>
				</div>
				<div class="search-title-row">
					<div class="min-w-0">
						<h1 id="search-title">Search</h1>
						<p>Prompts, responses, tool calls, paths, and errors across captured sessions.</p>
					</div>
				</div>
				<form id="search-form" class="search-form" onsubmit="return false;">
					<label class="sr-only" for="search-input">Search conversations</label>
					<span class="search-input-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
							<circle cx="11" cy="11" r="7" stroke-width="2"></circle>
							<path stroke-linecap="round" stroke-width="2" d="M20 20l-3.5-3.5"></path>
						</svg>
					</span>
					<input
						type="search"
						id="search-input"
						name="q"
						autocomplete="off"
						placeholder="Search conversations, tools, paths, errors"
						class="search-input"
						hx-get="/search/results"
						hx-trigger="input changed delay:250ms, search-refresh from:body"
						hx-target="#search-results"
						hx-include="#search-filters"
						hx-indicator="#search-spinner"
						hx-sync="this:replace"
					/>
					<div class="search-input-actions">
						<button type="button" id="search-clear" onclick="clearSearch()" class="search-icon-btn hidden" title="Clear search" aria-label="Clear search">
							<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
						</button>
						<div id="search-spinner" class="htmx-indicator">
							<svg class="search-spinner" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
						</div>
					</div>
				</form>
				<div id="search-filters">
					@components.FilterBar()
				</div>
			</section>
			<section class="search-results-shell" aria-label="Search results">
				<div id="search-results" class="search-results-list" aria-live="polite" aria-busy="false">
					for _, r := range results {
						@components.SearchResultCard(r)
					}
					if len(results) == 0 {
						@partials.SearchResultsState(nil, -1, false, "idle")
					}
				</div>
			</section>
		</div>
		<script>
		var searchInput = document.getElementById('search-input');
		var clearBtn = document.getElementById('search-clear');
		var searchResults = document.getElementById('search-results');
		// HTMX logs expected replace-abort events before listeners can cancel them.
		(function() {
			if (!window.console || typeof window.console.error !== 'function') return;
			window.__beaconSearchAbortFilter = window.__beaconSearchAbortFilter || {
				pending: 0,
				original: window.console.error.bind(window.console)
			};
			var filter = window.__beaconSearchAbortFilter;
			if (!filter.installed) {
				window.console.error = function() {
					var message = arguments.length === 1 ? String(arguments[0]) : '';
					var eventType = arguments.length === 1 && arguments[0] && typeof arguments[0] === 'object' ? arguments[0].type : '';
					var isExpectedAbort = message === 'htmx:afterRequest' || message === 'htmx:sendAbort' ||
						eventType === 'htmx:afterRequest' || eventType === 'htmx:sendAbort';
					if (filter.pending > 0 && isExpectedAbort) {
						filter.pending--;
						return;
					}
					filter.original.apply(window.console, arguments);
				};
				filter.installed = true;
			}
			searchInput.addEventListener('htmx:abort', function() {
				filter.pending += 2;
				setTimeout(function() {
					filter.pending = Math.max(0, filter.pending - 2);
				}, 1000);
			});
		})();
		function syncSearchClear() {
			clearBtn.classList.toggle('hidden', searchInput.value === '');
		}
		searchInput.addEventListener('input', syncSearchClear);
		searchInput.addEventListener('keydown', function(e) {
			if (e.key === 'Escape' && searchInput.value !== '') {
				e.preventDefault();
				clearSearch();
			}
		});
		document.body.addEventListener('htmx:beforeRequest', function(e) {
			if (e.detail.elt === searchInput && searchResults) {
				searchResults.setAttribute('aria-busy', 'true');
			}
		});
		document.body.addEventListener('htmx:afterSettle', function(e) {
			if (e.detail.elt === searchInput && searchResults) {
				searchResults.setAttribute('aria-busy', 'false');
			}
		});
		function clearSearch() {
			searchInput.value = '';
			syncSearchClear();
			htmx.trigger(searchInput, 'input');
			searchInput.focus();
		}
		syncSearchClear();
		</script>
	}
}
