package pages

import (
	"fmt"
	"strings"
	"github.com/johnnygreco/beacon/internal/views"
	"github.com/johnnygreco/beacon/internal/views/components"
)

templ SessionDetail(data views.SessionDetailData) {
	@views.Layout("Session " + data.Session.ID) {
		<div hx-ext="sse" sse-connect={ fmt.Sprintf("/sse/session/%s", data.Session.ID) } class="space-y-6">
			<!-- Session Header -->
			<div class={ "bg-gray-800 rounded-lg p-6 border", templ.KV("border-blue-500/30", data.Session.IsSubagent()), templ.KV("border-gray-700", !data.Session.IsSubagent()) }>
				<div class="flex items-center justify-between mb-4">
					<div>
						<div class="flex items-center gap-3">
							<h1 class="text-2xl font-bold text-gray-100">{ views.SessionTitle(data.Session, true) }</h1>
							if data.Session.IsSubagent() {
								<span class="px-2 py-0.5 text-xs font-semibold uppercase rounded-full bg-blue-500/20 text-blue-400">Subagent</span>
							}
						</div>
						if data.Session.IsSubagent() {
							<a href={ templ.SafeURL(fmt.Sprintf("/sessions/%s", data.Session.ParentSessionID)) }
							   class="text-sm text-blue-400/70 hover:text-blue-300 transition-colors mt-1 inline-flex items-center gap-1">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"></path>
								</svg>
								Parent session { views.TruncateID(data.Session.ParentSessionID) }
							</a>
						}
						if data.Session.WorkingDir != "" {
							<p class="text-sm text-gray-500 mt-1 truncate" title={ data.Session.WorkingDir }>{ data.Session.WorkingDir }</p>
						}
						<p class="text-sm text-gray-500 mt-1 font-mono">{ data.Session.ID }</p>
					</div>
					if data.Session.Status == "active" {
						if data.Session.IsSubagent() {
							<span class="px-3 py-1 text-sm font-semibold uppercase rounded-full bg-blue-500/20 text-blue-400">Active</span>
						} else {
							<span class="px-3 py-1 text-sm font-semibold uppercase rounded-full bg-green-500/20 text-green-400">Active</span>
						}
					} else if data.Session.Status == "idle" {
						<span class="px-3 py-1 text-sm font-semibold uppercase rounded-full bg-amber-500/20 text-amber-400">Idle</span>
					} else {
						<span class="px-3 py-1 text-sm font-semibold uppercase rounded-full bg-gray-600/40 text-gray-400">Completed</span>
					}
				</div>
				<div class="grid grid-cols-2 md:grid-cols-5 gap-4 text-sm">
					<div>
						<span class="text-gray-500">Duration</span>
						<p class="text-gray-200 font-medium">{ data.Session.Duration }</p>
					</div>
					<div>
						<span class="text-gray-500">Total Tokens</span>
						<p class="text-gray-200 font-medium">{ views.FormatTokens(data.Session.TotalTokens) }</p>
						<p class="text-xs text-gray-500 mt-0.5">
							In: { views.FormatTokens(data.Session.InputTokens) } / Out: { views.FormatTokens(data.Session.OutputTokens) }
						</p>
					</div>
					<div>
						<span class="text-gray-500">Cache Tokens</span>
						<p class="text-gray-200 font-medium">{ views.FormatTokens(data.Session.CacheReadTokens) }</p>
						<p class="text-xs text-gray-500 mt-0.5">
							Create: { views.FormatTokens(data.Session.CacheCreateTokens) }
						</p>
					</div>
					<div>
						<span class="text-gray-500">Turns</span>
						<p class="text-gray-200 font-medium">{ fmt.Sprintf("%d", data.Session.TurnCount) }</p>
					</div>
					<div>
						<span class="text-gray-500">Tool Calls</span>
						<p class="text-gray-200 font-medium">{ fmt.Sprintf("%d", data.Session.ToolCallCount) }</p>
						if data.Session.MCPCallCount > 0 {
							<p class="text-xs text-gray-500 mt-0.5">
								{ fmt.Sprintf("%d MCP", data.Session.MCPCallCount) }
							</p>
						}
					</div>
				</div>
			</div>

			<!-- Charts -->
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
				@components.ChartContainerWithOptions("sessionTokensChart", "200px", "Total Tokens Over Time", true, false)
				if len(data.TokensByModel) > 0 {
					@components.ChartContainerWithOptions("sessionTokensByModelChart", "200px", "Tokens by Model", true, true)
				}
			</div>

			<!-- Tool Stats -->
			if len(data.ToolStats) > 0 {
				<div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
					<h2 class="text-lg font-semibold text-gray-200 mb-3">Tool Usage</h2>
					<div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3">
						for _, ts := range data.ToolStats {
							<div class="bg-gray-900 rounded p-3 border border-gray-700">
								<div class="flex items-center gap-1.5 mb-1">
									if ts.IsMCP {
										<span class="px-1.5 py-0.5 text-xs rounded bg-cyan-500/20 text-cyan-400">MCP</span>
									}
									<span class="text-sm text-gray-200 font-medium truncate" title={ ts.Name }>{ toolShortName(ts.Name) }</span>
								</div>
								<p class="text-xs text-gray-500">
									{ views.Pluralize(ts.Calls, "call") }
									if ts.AvgDuration > 0 {
										{ fmt.Sprintf(" · %.0fms avg", ts.AvgDuration) }
									}
								</p>
							</div>
						}
					</div>
				</div>
			}

			<!-- Subagent Sessions -->
			if len(data.Session.ChildSessions) > 0 {
				<div id="subagent-sessions" class="bg-gray-800 rounded-lg p-4 border border-blue-500/20">
					<h2 class="text-lg font-semibold text-gray-200 mb-3 flex items-center gap-2">
						<svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
						</svg>
						Subagent Sessions
						<span class="text-sm font-normal text-gray-500">{ fmt.Sprintf("(%d)", len(data.Session.ChildSessions)) }</span>
					</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
						for _, child := range data.Session.ChildSessions {
							@components.SubagentSessionCard(child)
						}
					</div>
				</div>
			}

			<!-- Conversation (lazy-loaded for fast initial render) -->
			<div>
				<div class="flex items-center justify-between mb-4">
					<h2 class="text-lg font-semibold text-gray-200">Conversation</h2>
					<div class="flex items-center gap-2">
						<button id="btn-expand-all" onclick="expandAll()"
								class="px-2 py-1 text-xs rounded border border-gray-700 text-gray-500 hover:text-gray-300 hover:border-gray-500 transition-colors">
							Expand All
						</button>
						<button id="btn-collapse-all" onclick="collapseAll()"
								class="px-2 py-1 text-xs rounded border border-gray-700 text-gray-500 hover:text-gray-300 hover:border-gray-500 transition-colors">
							Collapse All
						</button>
						<div class="w-px h-5 bg-gray-700"></div>
						<button onclick="switchView('chat', this)"
								class="px-3 py-1.5 text-sm rounded-md font-medium border bg-blue-500/20 text-blue-400 border-blue-500/40">Chat</button>
						<button onclick="switchView('timeline', this)"
								class="px-3 py-1.5 text-sm rounded-md font-medium border bg-gray-800 text-gray-500 border-gray-700">Timeline</button>
					</div>
				</div>
				<div id="conversation-container"
					 hx-get={ fmt.Sprintf("/sessions/%s/conversation", data.Session.ID) }
					 hx-trigger="load"
					 hx-swap="innerHTML">
					<div class="flex items-center justify-center py-12 text-gray-500">
						<svg class="animate-spin h-5 w-5 mr-3" viewBox="0 0 24 24">
							<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
							<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
						</svg>
						Loading conversation...
					</div>
				</div>
			</div>

			<!-- Initial chart data embedded as JSON -->
			@templ.JSONScript("session-tokens-data", multiSeriesChartData(data.TokensChart))
			if len(data.TokensByModel) > 0 {
				@templ.JSONScript("session-tokens-by-model-data", tokensByModelData(data.TokensByModel))
			}
		</div>
	}
}

func multiSeriesChartData(data views.MultiSeriesChart) any {
	return map[string]any{"labels": data.Labels, "datasets": data.Datasets}
}

func tokensByModelData(models []views.ChartDataset) any {
	labels := []string{"Input", "Output", "Cache Read"}
	datasets := make([]map[string]any, len(models))
	for i, m := range models {
		datasets[i] = map[string]any{"label": m.Label, "data": m.Values}
	}
	return map[string]any{"labels": labels, "datasets": datasets}
}

func toolShortName(name string) string {
	// For MCP tools like "mcp__claude-in-chrome__computer", show "computer"
	parts := strings.Split(name, "__")
	if len(parts) >= 3 {
		return parts[len(parts)-1]
	}
	return name
}
