package pages

import (
	"github.com/johnnygreco/beacon/internal/views"
	"github.com/johnnygreco/beacon/internal/views/components"
)

templ Dashboard(data views.DashboardData) {
	@views.Layout("Dashboard") {
		<div id="dashboard-wrap" class="flex h-[calc(100vh-3rem)]">
			<!-- Main Content Area -->
			<div id="dashboard-main" class="flex-1 flex flex-col gap-6 overflow-y-auto min-w-0 pr-0">
				<div class="space-y-6">
					<section class="space-y-4">
						<div class="flex flex-wrap items-center justify-between gap-3">
							<div>
								<h1 class="text-xl font-semibold text-gray-100">Live Analytics</h1>
								<p id="dashboard-range-caption" class="text-xs text-gray-500 mt-0.5">Last 24 hours</p>
							</div>
							<div id="dashboard-range-control" class="flex flex-wrap items-center gap-1.5">
								<span class="text-xs text-gray-500 mr-1">Time Range</span>
								<button type="button" onclick="setDashboardRange(this, '')" class="dash-range-btn px-2 py-1 text-xs rounded border border-gray-600 text-gray-400 hover:text-gray-200 hover:border-gray-500 transition-colors">All</button>
								<button type="button" onclick="setDashboardRange(this, '1h')" class="dash-range-btn px-2 py-1 text-xs rounded border border-gray-600 text-gray-400 hover:text-gray-200 hover:border-gray-500 transition-colors">1h</button>
								<button type="button" onclick="setDashboardRange(this, '24h')" class="dash-range-btn px-2 py-1 text-xs rounded border border-blue-500/40 bg-blue-500/20 text-blue-400 transition-colors">24h</button>
								<button type="button" onclick="setDashboardRange(this, '7d')" class="dash-range-btn px-2 py-1 text-xs rounded border border-gray-600 text-gray-400 hover:text-gray-200 hover:border-gray-500 transition-colors">7d</button>
								<button type="button" onclick="setDashboardRange(this, '30d')" class="dash-range-btn px-2 py-1 text-xs rounded border border-gray-600 text-gray-400 hover:text-gray-200 hover:border-gray-500 transition-colors">30d</button>
							</div>
						</div>
						<div id="dashboard-analytics-summary" class="dashboard-summary-grid"></div>
						<div class="dashboard-analytics-grid">
							<div class="min-w-0">
								@components.ChartContainerWithOptions("dashboardTokenCumulativeChart", "320px", "Cumulative Tokens by Model", true, false)
							</div>
							<div class="min-w-0 bg-gray-800 rounded-lg p-4 border border-gray-700">
								<div class="flex flex-wrap items-center justify-between gap-2 mb-2">
									<h3 class="text-sm font-medium text-gray-400">Model Health</h3>
									<div id="dashboard-model-metric-control" class="inline-flex overflow-hidden rounded border border-gray-700">
										<button type="button" data-dashboard-metric="error_rate" onclick="setDashboardMetric(this, 'error_rate')" class="dashboard-metric-btn px-2 py-1 text-xs bg-blue-500/20 text-blue-400 border-r border-gray-700">Error Rate</button>
										<button type="button" data-dashboard-metric="errors" onclick="setDashboardMetric(this, 'errors')" class="dashboard-metric-btn px-2 py-1 text-xs text-gray-400 hover:text-gray-200 border-r border-gray-700">Errors</button>
										<button type="button" data-dashboard-metric="tool_calls" onclick="setDashboardMetric(this, 'tool_calls')" class="dashboard-metric-btn px-2 py-1 text-xs text-gray-400 hover:text-gray-200">Tools</button>
									</div>
								</div>
								<div style="position:relative;height:320px">
									<canvas id="dashboardModelActivityChart" data-default-log="false"></canvas>
								</div>
							</div>
						</div>
					</section>
					@templ.JSONScript("dashboard-token-cumulative-data", data.TokenCumulative)
					@templ.JSONScript("dashboard-model-activity-data", data.ModelActivity)

					<!-- Active Sessions -->
					<div id="active-sessions">
						<h2 class="text-lg font-semibold text-gray-200 mb-3 flex items-center gap-2">
							<span class="relative flex h-2 w-2">
								<span class="relative inline-flex rounded-full h-2 w-2 bg-gray-600"></span>
							</span>
							Active Sessions
						</h2>
						<div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
							<div class="text-center py-6 col-span-full">
								<p class="text-sm text-gray-500">Loading active sessions...</p>
							</div>
						</div>
					</div>

					<!-- Completed Sessions Table -->
					<div class="border-t border-gray-700/50 pt-4">
						<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
							<h2 class="text-sm font-medium text-gray-400 uppercase tracking-wide">Completed Sessions</h2>
						</div>
						<div class="overflow-x-auto">
							<table class="w-full text-sm" id="completed-table">
								<thead class="sticky top-0 bg-gray-900/95 backdrop-blur">
									<tr class="text-xs text-gray-500 uppercase tracking-wider border-b border-gray-700">
										<th class="text-left py-2 px-3 font-medium cursor-pointer hover:text-gray-300 select-none" data-sort-key="name" onclick="sortCompletedTable(this, 'name')">
											Name <span class="sort-arrow">▼</span>
										</th>
										<th class="text-left py-2 px-3 font-medium cursor-pointer hover:text-gray-300 select-none" data-sort-key="provider" onclick="sortCompletedTable(this, 'provider')">
											Provider <span class="sort-arrow">▼</span>
										</th>
										<th class="text-left py-2 px-3 font-medium cursor-pointer hover:text-gray-300 select-none" data-sort-key="model" onclick="sortCompletedTable(this, 'model')">
											Model <span class="sort-arrow">▼</span>
										</th>
										<th class="text-right py-2 px-3 font-medium cursor-pointer hover:text-gray-300 select-none" data-sort-key="tokens" onclick="sortCompletedTable(this, 'tokens')">
											Tokens <span class="sort-arrow">▼</span>
										</th>
										<th class="text-right py-2 px-3 font-medium cursor-pointer hover:text-gray-300 select-none" data-sort-key="turns" onclick="sortCompletedTable(this, 'turns')">
											Turns <span class="sort-arrow">▼</span>
										</th>
										<th class="text-right py-2 px-3 font-medium cursor-pointer hover:text-gray-300 select-none" data-sort-key="tools" onclick="sortCompletedTable(this, 'tools')">
											Tools <span class="sort-arrow">▼</span>
										</th>
										<th class="text-right py-2 px-3 font-medium cursor-pointer hover:text-gray-300 select-none" data-sort-key="duration" onclick="sortCompletedTable(this, 'duration')">
											Duration <span class="sort-arrow">▼</span>
										</th>
										<th class="text-left py-2 px-3 font-medium cursor-pointer hover:text-gray-300 select-none" data-sort-key="project" onclick="sortCompletedTable(this, 'project')">
											Project <span class="sort-arrow">▼</span>
										</th>
										<th class="text-right py-2 px-3 font-medium cursor-pointer hover:text-gray-300 select-none" data-sort-key="ended" onclick="sortCompletedTable(this, 'ended')">
											Ended <span class="sort-arrow active">▼</span>
										</th>
										<th class="text-left py-2 px-3 font-medium cursor-pointer hover:text-gray-300 select-none" data-sort-key="id" onclick="sortCompletedTable(this, 'id')">
											Session ID <span class="sort-arrow">▼</span>
										</th>
									</tr>
								</thead>
								<tbody id="completed-sessions">
									<tr>
										<td colspan="10" class="text-center py-4">
											<span class="text-sm text-gray-500">Loading sessions...</span>
										</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>

			<!-- Draggable Divider -->
			<div id="sidebar-divider" class="sidebar-divider" title="Drag to resize sidebar">
				<div class="sidebar-divider-line"></div>
			</div>

			<!-- Activity Timeline Sidebar -->
			<aside id="timeline-sidebar" class="timeline-panel flex flex-col bg-gray-800/30">
				<div class="flex items-center justify-between px-4 py-3 border-b border-gray-700/50 flex-shrink-0">
					<h2 class="text-sm font-medium text-gray-400 uppercase tracking-wide whitespace-nowrap">Activity Timeline <span class="text-gray-600 normal-case">(24h)</span></h2>
				</div>
				<div class="flex items-center gap-1.5 px-4 py-2 border-b border-gray-700/50 flex-shrink-0">
					<button type="button" onclick="filterActivity(this, 'all')" class="activity-filter-btn px-2 py-1 text-xs rounded border border-blue-500/40 bg-blue-500/20 text-blue-400 transition-colors">All</button>
					<button type="button" onclick="filterActivity(this, 'message')" class="activity-filter-btn px-2 py-1 text-xs rounded border border-gray-600 text-gray-400 hover:text-gray-200 hover:border-gray-500 transition-colors">Messages</button>
					<button type="button" onclick="filterActivity(this, 'tool_call')" class="activity-filter-btn px-2 py-1 text-xs rounded border border-gray-600 text-gray-400 hover:text-gray-200 hover:border-gray-500 transition-colors">Tools</button>
					<button type="button" onclick="filterActivity(this, 'error')" class="activity-filter-btn px-2 py-1 text-xs rounded border border-gray-600 text-gray-400 hover:text-gray-200 hover:border-gray-500 transition-colors">Errors</button>
				</div>
				<div id="activity-feed" class="overflow-y-auto flex-1 min-h-0">
					<p class="text-sm text-gray-500 text-center py-4">Loading activity...</p>
				</div>
			</aside>

			<div id="session-inspector" class="hidden fixed inset-y-0 right-0 w-full max-w-2xl bg-gray-950 border-l border-gray-700 shadow-2xl z-[60] flex flex-col">
				<div class="flex items-center justify-between px-4 py-3 border-b border-gray-800">
					<div class="min-w-0">
						<h2 id="inspector-title" class="text-sm font-semibold text-gray-100 truncate">Session</h2>
						<p id="inspector-subtitle" class="text-xs text-gray-500 font-mono truncate"></p>
					</div>
					<div class="flex items-center gap-2">
						<a id="inspector-full-link" href="#" class="text-xs px-2 py-1 rounded border border-gray-700 text-gray-400 hover:text-gray-200">Full Page</a>
						<button type="button" onclick="closeSessionInspector()" class="text-gray-500 hover:text-gray-200" title="Close" aria-label="Close">✕</button>
					</div>
				</div>
				<div id="inspector-summary" class="grid grid-cols-2 md:grid-cols-4 gap-3 p-4 border-b border-gray-800 text-sm"></div>
				<div id="inspector-events" class="flex-1 overflow-y-auto p-4 space-y-2"></div>
			</div>

			</div>

		<script src="/static/js/vendor/chart.umd.min.js"></script>
		<script src="/static/js/vendor/chartjs-adapter-date-fns.bundle.min.js"></script>
		<script src="/static/js/charts.js"></script>
		<script src="/static/js/dashboard.js"></script>
	}
}

func dashboardTokensByModelData(models []views.ModelTokens) any {
	return tokensByModelChartData(models)
}

// tokensByModelChartData builds Chart.js data with models grouped by provider.
// The shared chart uses normalized labels across providers:
// Input = fresh/uncached input, Output = provider-reported output,
// Cache = cache read tokens.
func tokensByModelChartData(models []views.ModelTokens) any {
	sorted := views.SortModelsByProvider(models)
	multiProvider := hasMultipleProviders(sorted)

	var labels []string
	var inputData, outputData, cacheData []int64
	// providerGroups maps bar index ranges to provider names for header rendering
	var providerGroups []map[string]any

	lastProvider := ""
	groupStart := 0
	for i, m := range sorted {
		p := m.Provider
		if p == "" {
			p = "unknown"
		}
		// Track provider group boundaries (no spacer bar)
		if multiProvider && lastProvider != "" && p != lastProvider {
			providerGroups = append(providerGroups, map[string]any{
				"provider": views.ProviderShort(lastProvider),
				"start":    groupStart,
				"end":      len(labels) - 1,
			})
			groupStart = len(labels)
		}
		lastProvider = p

		label := views.ShortModelName(m.Model)
		labels = append(labels, label)
		inputData = append(inputData, m.Input)
		outputData = append(outputData, m.Output)
		cacheData = append(cacheData, m.CacheRead)

		// Close last provider group
		if multiProvider && i == len(sorted)-1 {
			providerGroups = append(providerGroups, map[string]any{
				"provider": views.ProviderShort(p),
				"start":    groupStart,
				"end":      len(labels) - 1,
			})
		}
	}
	result := map[string]any{
		"labels": labels,
		"datasets": []map[string]any{
			{"label": "Input", "data": inputData},
			{"label": "Output", "data": outputData},
			{"label": "Cache", "data": cacheData},
		},
	}
	if multiProvider && len(providerGroups) > 0 {
		result["providerGroups"] = providerGroups
	}
	return result
}

func hasMultipleProviders(models []views.ModelTokens) bool {
	if len(models) <= 1 {
		return false
	}
	first := models[0].Provider
	for _, m := range models[1:] {
		if m.Provider != first {
			return true
		}
	}
	return false
}
