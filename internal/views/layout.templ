package views

templ Layout(title string, page string) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } | Beacon</title>
		<link rel="icon" href={ AssetURL("/static/favicon.svg") } type="image/svg+xml"/>
		<script src={ AssetURL("/static/js/prelude.js") }></script>
		<script src={ AssetURL("/static/js/vendor/htmx.min.js") }></script>
		<script src={ AssetURL("/static/js/vendor/htmx-ext-sse.js") }></script>
		<link rel="stylesheet" href={ AssetURL("/static/css/tailwind.css") }/>
		<link rel="stylesheet" href={ AssetURL("/static/css/custom.css") }/>
	</head>
	<body data-page={ page } class="bg-gray-900 text-gray-100 min-h-screen">
		<main id="main-content" class="min-h-screen w-full p-6 overflow-y-auto">
			{ children... }
		</main>
	</body>
	</html>
}
