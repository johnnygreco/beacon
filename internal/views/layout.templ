package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } | Technodrome</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<script src="/static/js/vendor/htmx.min.js"></script>
		<script src="/static/js/vendor/htmx-ext-sse.js"></script>
		<script src="/static/js/vendor/chart.umd.min.js"></script>
		<script src="/static/js/vendor/chartjs-adapter-date-fns.bundle.min.js"></script>
		<link rel="stylesheet" href="/static/css/custom.css"/>
		<link rel="stylesheet" href="/static/css/vendor/github-dark.min.css"/>
	</head>
	<body class="bg-gray-900 text-gray-100 min-h-screen flex">
		@Nav()
		<main class="flex-1 ml-64 p-6 overflow-y-auto">
			{ children... }
		</main>
		<script src="/static/js/charts.js"></script>
		<script src="/static/js/sse-chart-bridge.js"></script>
		<script src="/static/js/vendor/highlight.min.js"></script>
	</body>
	</html>
}

templ Nav() {
	<nav class="fixed left-0 top-0 h-full w-64 bg-gray-800 border-r border-gray-700 flex flex-col z-50">
		<div class="p-6 border-b border-gray-700">
			<h1 class="text-xl font-bold text-blue-400">Technodrome</h1>
			<p class="text-xs text-gray-500 mt-1">AI Agent Monitor</p>
		</div>
		<div class="flex-1 py-4">
			<a href="/" class="flex items-center px-6 py-3 text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
				<svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
				</svg>
				Dashboard
			</a>
			<a href="/search" class="flex items-center px-6 py-3 text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
				<svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
				</svg>
				Search
			</a>
		</div>
		<div class="border-t border-gray-700 py-3">
			<h3 class="px-6 text-[10px] font-medium text-gray-500 uppercase tracking-wider mb-2">Stats</h3>
			<div id="sidebar-metrics" hx-get="/partials/sidebar-metrics" hx-trigger="load">
			</div>
		</div>
		<div id="sse-status-bar" class="p-4 border-t border-gray-700 hidden">
			<div class="flex items-center gap-3 text-xs text-gray-500">
				<span id="sse-indicator" class="w-2 h-2 rounded-full bg-gray-600 flex-shrink-0"></span>
				<span id="sse-status">Connecting...</span>
			</div>
		</div>
	</nav>
}
