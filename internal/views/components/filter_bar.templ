package components

templ FilterBar() {
	<div class="flex flex-wrap items-center gap-3 p-3 bg-gray-800 rounded-lg border border-gray-700">
		<div>
			<label class="text-xs text-gray-500 block mb-1">Time Range</label>
			<div class="flex items-center gap-1">
				<button type="button" onclick="setRange(this, '')" class="range-btn px-2 py-1 text-xs rounded border border-blue-500/40 bg-blue-500/20 text-blue-400 transition-colors">All</button>
				<button type="button" onclick="setRange(this, '1h')" class="range-btn px-2 py-1 text-xs rounded border border-gray-600 text-gray-400 hover:text-gray-200 hover:border-gray-500 transition-colors">1h</button>
				<button type="button" onclick="setRange(this, '24h')" class="range-btn px-2 py-1 text-xs rounded border border-gray-600 text-gray-400 hover:text-gray-200 hover:border-gray-500 transition-colors">24h</button>
				<button type="button" onclick="setRange(this, '7d')" class="range-btn px-2 py-1 text-xs rounded border border-gray-600 text-gray-400 hover:text-gray-200 hover:border-gray-500 transition-colors">7d</button>
				<button type="button" onclick="setRange(this, '30d')" class="range-btn px-2 py-1 text-xs rounded border border-gray-600 text-gray-400 hover:text-gray-200 hover:border-gray-500 transition-colors">30d</button>
			</div>
			<input type="hidden" id="filter-range" name="range" value=""/>
		</div>
		<div>
			<label class="text-xs text-gray-500 block mb-1" for="filter-session">Session</label>
			<input type="text" id="filter-session" name="session_id" placeholder="All sessions"
				class="bg-gray-700 text-gray-200 text-sm rounded px-2 py-1 border border-gray-600 focus:border-blue-500 focus:outline-none w-32"/>
		</div>
		<div>
			<label class="text-xs text-gray-500 block mb-1" for="filter-event-kind">Event Kind</label>
			<select id="filter-event-kind" name="event_kind"
				class="bg-gray-700 text-gray-200 text-sm rounded px-2 py-1 border border-gray-600 focus:border-blue-500 focus:outline-none">
				<option value="">All</option>
				<option value="message">Message</option>
				<option value="tool_call">Tool Call</option>
				<option value="tool_result">Tool Result</option>
				<option value="reasoning">Reasoning</option>
				<option value="error">Error</option>
			</select>
		</div>
	</div>
	<script>
	function setRange(btn, value) {
		document.getElementById('filter-range').value = value;
		btn.closest('.flex').querySelectorAll('.range-btn').forEach(function(b) {
			b.className = 'range-btn px-2 py-1 text-xs rounded border border-gray-600 text-gray-400 hover:text-gray-200 hover:border-gray-500 transition-colors';
		});
		btn.className = 'range-btn px-2 py-1 text-xs rounded border border-blue-500/40 bg-blue-500/20 text-blue-400 transition-colors';
		// Trigger HTMX search refresh
		var input = document.querySelector('input[name="q"]');
		if (input && input.value) htmx.trigger(input, 'input');
	}
	</script>
}
