package components

templ FilterBar() {
	<div class="search-filter-bar">
		<div class="search-filter-group search-filter-range" role="group" aria-label="Time range">
			<input type="hidden" id="filter-range" name="range" value=""/>
			<button type="button" onclick="setSearchFilter('range', '', this)" aria-pressed="true" class="search-filter-btn is-active">All</button>
			<button type="button" onclick="setSearchFilter('range', '1h', this)" aria-pressed="false" class="search-filter-btn">1h</button>
			<button type="button" onclick="setSearchFilter('range', '24h', this)" aria-pressed="false" class="search-filter-btn">24h</button>
			<button type="button" onclick="setSearchFilter('range', '7d', this)" aria-pressed="false" class="search-filter-btn">7d</button>
			<button type="button" onclick="setSearchFilter('range', '30d', this)" aria-pressed="false" class="search-filter-btn">30d</button>
		</div>
		<div class="search-filter-group search-filter-events" role="group" aria-label="Event kind">
			<input type="hidden" id="filter-event-kind" name="event_kind" value=""/>
			<button type="button" onclick="setSearchFilter('event-kind', '', this)" aria-pressed="true" class="search-filter-btn is-active" title="All events" aria-label="All events">
				<span aria-hidden="true">All</span>
			</button>
			<button type="button" onclick="setSearchFilter('event-kind', 'message', this)" aria-pressed="false" class="search-filter-btn" title="Messages" aria-label="Messages">
				<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 6h14M5 12h10M5 18h7"></path>
				</svg>
			</button>
			<button type="button" onclick="setSearchFilter('event-kind', 'tool_call', this)" aria-pressed="false" class="search-filter-btn" title="Tool calls" aria-label="Tool calls">
				<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17v3h3l5.3-5.3a4 4 0 0 0 5.4-5.4l-3 3-3-3 3-3z"></path>
				</svg>
			</button>
			<button type="button" onclick="setSearchFilter('event-kind', 'tool_result', this)" aria-pressed="false" class="search-filter-btn" title="Tool results" aria-label="Tool results">
				<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 12 4 4L19 6"></path>
				</svg>
			</button>
			<button type="button" onclick="setSearchFilter('event-kind', 'reasoning', this)" aria-pressed="false" class="search-filter-btn" title="Reasoning" aria-label="Reasoning">
				<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 18h6M10 22h4M8.5 14.5a6 6 0 1 1 7 0c-.7.5-.9 1.2-.9 2H9.4c0-.8-.2-1.5-.9-2z"></path>
				</svg>
			</button>
			<button type="button" onclick="setSearchFilter('event-kind', 'error', this)" aria-pressed="false" class="search-filter-btn" title="Errors" aria-label="Errors">
				<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.3 4.3 2.8 17.2A2 2 0 0 0 4.5 20h15a2 2 0 0 0 1.7-2.8L13.7 4.3a2 2 0 0 0-3.4 0z"></path>
				</svg>
			</button>
		</div>
		<div class="search-session-filter">
			<label class="sr-only" for="filter-session">Session ID</label>
			<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h10M7 12h10M7 17h6"></path>
			</svg>
			<input type="text" id="filter-session" name="session_id" placeholder="Session ID" autocomplete="off" oninput="triggerSearchDebounced()" class="search-session-input"/>
		</div>
		<label class="search-select-wrap">
			<span class="sr-only">Sort results</span>
			<select id="filter-sort" name="sort" onchange="triggerSearch()" class="search-select" aria-label="Sort results">
				<option value="relevance">Relevance</option>
				<option value="newest">Newest</option>
				<option value="oldest">Oldest</option>
			</select>
		</label>
		<label class="search-select-wrap search-limit-wrap">
			<span class="sr-only">Result limit</span>
			<select id="filter-limit" name="limit" onchange="triggerSearch()" class="search-select" aria-label="Result limit">
				<option value="30">30</option>
				<option value="60">60</option>
				<option value="120">120</option>
				<option value="240">240</option>
			</select>
		</label>
		<button type="button" onclick="resetSearchFilters()" class="search-icon-btn" title="Reset filters" aria-label="Reset filters">
			<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12a9 9 0 1 0 3-6.7"></path>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4v5h5"></path>
			</svg>
		</button>
	</div>
	<script>
	function triggerSearch() {
		htmx.trigger(document.body, 'search-refresh');
	}
	var _searchTimer;
	function triggerSearchDebounced() {
		clearTimeout(_searchTimer);
		_searchTimer = setTimeout(triggerSearch, 250);
	}
	function setSearchFilter(name, value, btn) {
		var input = document.getElementById('filter-' + name);
		if (input) input.value = value;
		var group = btn.closest('.search-filter-group');
		if (group) {
			group.querySelectorAll('.search-filter-btn').forEach(function(b) {
				b.classList.remove('is-active');
				b.setAttribute('aria-pressed', 'false');
			});
		}
		btn.classList.add('is-active');
		btn.setAttribute('aria-pressed', 'true');
		triggerSearch();
	}
	function resetButtonGroup(group) {
		if (!group) return;
		var buttons = group.querySelectorAll('.search-filter-btn');
		buttons.forEach(function(button, index) {
			button.classList.toggle('is-active', index === 0);
			button.setAttribute('aria-pressed', index === 0 ? 'true' : 'false');
		});
	}
	function resetSearchFilters() {
		document.getElementById('filter-range').value = '';
		document.getElementById('filter-event-kind').value = '';
		document.getElementById('filter-session').value = '';
		document.getElementById('filter-sort').value = 'relevance';
		document.getElementById('filter-limit').value = '30';
		resetButtonGroup(document.querySelector('.search-filter-range'));
		resetButtonGroup(document.querySelector('.search-filter-events'));
		triggerSearch();
	}
	function increaseLimit() {
		var sel = document.getElementById('filter-limit');
		var idx = sel.selectedIndex;
		if (idx < sel.options.length - 1) {
			sel.selectedIndex = idx + 1;
			triggerSearch();
		}
	}
	document.addEventListener('keydown', function(e) {
		var tagName = document.activeElement ? document.activeElement.tagName : '';
		if (e.key === '/' && !e.ctrlKey && !e.metaKey && !['INPUT', 'TEXTAREA', 'SELECT'].includes(tagName)) {
			e.preventDefault();
			document.querySelector('input[name="q"]').focus();
		}
	});
	</script>
}
