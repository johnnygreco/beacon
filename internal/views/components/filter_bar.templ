package components

templ FilterBar() {
	<div class="flex flex-wrap items-center gap-3 p-3 bg-gray-800 rounded-lg border border-gray-700">
		<div>
			<label class="text-xs text-gray-500 block mb-1" for="filter-from">From</label>
			<input type="datetime-local" id="filter-from" name="from"
				class="bg-gray-700 text-gray-200 text-sm rounded px-2 py-1 border border-gray-600 focus:border-blue-500 focus:outline-none"/>
		</div>
		<div>
			<label class="text-xs text-gray-500 block mb-1" for="filter-to">To</label>
			<input type="datetime-local" id="filter-to" name="to"
				class="bg-gray-700 text-gray-200 text-sm rounded px-2 py-1 border border-gray-600 focus:border-blue-500 focus:outline-none"/>
		</div>
		<div>
			<label class="text-xs text-gray-500 block mb-1" for="filter-actor">Actor</label>
			<input type="text" id="filter-actor" name="actor" placeholder="All actors"
				class="bg-gray-700 text-gray-200 text-sm rounded px-2 py-1 border border-gray-600 focus:border-blue-500 focus:outline-none w-32"/>
		</div>
		<div>
			<label class="text-xs text-gray-500 block mb-1" for="filter-session">Session</label>
			<input type="text" id="filter-session" name="session_id" placeholder="All sessions"
				class="bg-gray-700 text-gray-200 text-sm rounded px-2 py-1 border border-gray-600 focus:border-blue-500 focus:outline-none w-32"/>
		</div>
		<div>
			<label class="text-xs text-gray-500 block mb-1" for="filter-match-type">Match Type</label>
			<select id="filter-match-type" name="match_type"
				class="bg-gray-700 text-gray-200 text-sm rounded px-2 py-1 border border-gray-600 focus:border-blue-500 focus:outline-none">
				<option value="">All</option>
				<option value="semantic">Semantic</option>
				<option value="keyword">Keyword</option>
				<option value="hybrid">Hybrid</option>
			</select>
		</div>
	</div>
}
