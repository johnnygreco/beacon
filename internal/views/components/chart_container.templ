package components

templ ChartContainer(id string, height string, title string) {
	<div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
		if title != "" {
			<h3 class="text-sm font-medium text-gray-400 mb-2">{ title }</h3>
		}
		<canvas id={ id } style={ "height:" + height }></canvas>
	</div>
}
