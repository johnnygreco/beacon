package components

import "strconv"

templ ChartContainer(id string, height string, title string) {
	@ChartContainerWithOptions(id, height, title, false, false)
}

templ ChartContainerWithOptions(id string, height string, title string, logToggle bool, defaultLog bool) {
	<div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
		<div class="chart-card-header flex flex-wrap items-start justify-between gap-2 mb-2">
			if title != "" {
				<h3 class="text-sm font-medium text-gray-400">{ title }</h3>
			}
			if logToggle {
				<button
					type="button"
					id={ id + "-log-toggle" }
					class={ logToggleClass(defaultLog) }
					data-chart-id={ id }
					data-log-active={ strconv.FormatBool(defaultLog) }
					aria-pressed={ strconv.FormatBool(defaultLog) }
				>
					Log Scale
				</button>
				}
			</div>
			<div style={ "position:relative;height:" + height }>
			<canvas id={ id } data-default-log={ strconv.FormatBool(defaultLog) } role="img" aria-label={ chartAccessibleLabel(id, title) }></canvas>
		</div>
	</div>
}

templ CompactChartContainerWithOptions(id string, height string, title string, logToggle bool, defaultLog bool) {
	<div class="dashboard-compact-chart">
		<div class="chart-card-header dashboard-compact-chart-header">
			if title != "" {
				<h3 class="dashboard-compact-chart-title">{ title }</h3>
			}
			if logToggle {
				<button
					type="button"
					id={ id + "-log-toggle" }
					class={ logToggleClass(defaultLog) }
					data-chart-id={ id }
					data-log-active={ strconv.FormatBool(defaultLog) }
					aria-pressed={ strconv.FormatBool(defaultLog) }
				>
					Log Scale
				</button>
			}
		</div>
		<div class="dashboard-compact-chart-canvas" style={ "position:relative;height:" + height }>
			<canvas id={ id } data-default-log={ strconv.FormatBool(defaultLog) } role="img" aria-label={ chartAccessibleLabel(id, title) }></canvas>
		</div>
	</div>
}

func logToggleClass(active bool) string {
	if active {
		return "log-scale-toggle px-2 py-1 text-xs rounded border bg-blue-500/20 text-blue-400 border-blue-500/40 hover:text-blue-300 transition-colors whitespace-nowrap"
	}
	return "log-scale-toggle px-2 py-1 text-xs rounded border border-gray-600 text-gray-400 hover:text-gray-200 hover:border-gray-500 transition-colors whitespace-nowrap"
}

func chartAccessibleLabel(id string, title string) string {
	if title != "" {
		return title + " chart"
	}
	return id + " chart"
}
