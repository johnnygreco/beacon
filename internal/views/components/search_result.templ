package components

import (
	"fmt"
	"github.com/johnnygreco/beacon/internal/views"
)

templ SearchResultCard(r views.SearchResult) {
	<div class="bg-gray-800 rounded-lg p-4 border border-gray-700 hover:border-gray-600 transition-colors">
		<div class="flex items-center justify-between mb-2">
			<a href={ templ.SafeURL(fmt.Sprintf("/sessions/%s", r.SessionID)) } class="text-sm text-blue-400 hover:underline">
				Session { r.SessionID }
			</a>
			<div class="flex items-center gap-2">
				<span class="px-2 py-0.5 text-xs font-semibold uppercase rounded-full bg-gray-600/40 text-gray-400">{ r.EventKind }</span>
				if r.Score > 0 {
					<span class="text-xs text-gray-500">{ fmt.Sprintf("%.2f", r.Score) }</span>
				}
			</div>
		</div>
		<p class="text-sm text-gray-300 leading-relaxed">{ r.Snippet }</p>
		<p class="text-xs text-gray-500 mt-2">{ views.FormatTime(r.Timestamp) }</p>
	</div>
}
