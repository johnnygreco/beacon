package components

import (
	"fmt"
	"github.com/technodrome-ai/technodrome/internal/models"
	"github.com/technodrome-ai/technodrome/internal/views"
)

templ ChatView(chatTurns []views.ChatTurn) {
	<div class="space-y-4">
		for i, ct := range chatTurns {
			if i > 0 {
				<div id={ fmt.Sprintf("turn-%d", ct.TurnSeq) } class="flex items-center gap-3 my-6 flex-wrap">
					<div class="flex-1 min-w-[2rem] h-px bg-gray-700"></div>
					<a href={ templ.SafeURL(fmt.Sprintf("#turn-%d", ct.TurnSeq)) }
					   class="text-xs text-gray-500 whitespace-nowrap hover:text-gray-300 transition-colors">
						{ fmt.Sprintf("Turn %d — %d tok", ct.TurnSeq, ct.TotalTokens) }
					</a>
					for _, stat := range ct.ToolStats {
						<span class="px-1.5 py-0.5 text-xs rounded bg-gray-700/50 text-gray-400 whitespace-nowrap">
							{ fmt.Sprintf("%d %s", stat.Count, toolDisplayName(stat.Name)) }
						</span>
					}
					<div class="flex-1 min-w-[2rem] h-px bg-gray-700"></div>
				</div>
			}
			for _, block := range ct.Blocks {
				if block.Kind == views.ChatBlockUserMessage && block.Message != nil && chatDisplayText(*block.Message) != "" {
					@chatUserMessage(*block.Message)
				} else if block.Kind == views.ChatBlockAssistantMessage && block.Message != nil && chatDisplayText(*block.Message) != "" {
					@chatAssistantMessage(*block.Message)
				} else if block.Kind == views.ChatBlockReasoning && block.Message != nil {
					@chatReasoningBlock(*block.Message)
				} else if block.Kind == views.ChatBlockError && block.Message != nil {
					@chatErrorBlock(*block.Message)
				} else if block.Kind == views.ChatBlockToolChain {
					@chatToolChain(block.ToolChain)
				}
			}
		}
	</div>
}

templ chatUserMessage(e views.EventSummary) {
	<div id={ e.EventUID } class="ml-auto max-w-[95%] sm:max-w-[85%] group border-l-4 border-blue-400">
		<div class="bg-blue-600/15 border border-blue-500/30 rounded-2xl rounded-br-sm px-4 py-3">
			if len(chatCleanUserText(e)) > 2000 {
				@truncatableBlock("#172033") {
					<div class="prose-chat prose-chat-user text-gray-100 text-sm leading-relaxed break-words">
						@templ.Raw(views.RenderMarkdown(chatCleanUserText(e)))
					</div>
				}
			} else {
				<div class="prose-chat prose-chat-user text-gray-100 text-sm leading-relaxed break-words">
					@templ.Raw(views.RenderMarkdown(chatCleanUserText(e)))
				</div>
			}
		</div>
		@chatMetaStrip(e)
	</div>
}

templ chatAssistantMessage(e views.EventSummary) {
	<div id={ e.EventUID } class="mr-auto max-w-[95%] sm:max-w-[85%] flex gap-3 group border-l-4 border-purple-400 pl-1">
		<div class="w-7 h-7 rounded-full bg-purple-500/20 flex items-center justify-center flex-shrink-0 mt-1">
			<span class="text-purple-400 text-xs font-bold">A</span>
		</div>
		<div class="flex-1 min-w-0">
			<div class="bg-gray-800 border border-gray-700 rounded-2xl rounded-bl-sm px-4 py-3">
				if len(chatDisplayText(e)) > 2000 {
					@truncatableBlock("#1f2937") {
						<div class="prose-chat text-gray-200 text-sm leading-relaxed break-words">
							@templ.Raw(views.RenderMarkdown(chatDisplayText(e)))
						</div>
					}
				} else {
					<div class="prose-chat text-gray-200 text-sm leading-relaxed break-words">
						@templ.Raw(views.RenderMarkdown(chatDisplayText(e)))
					</div>
				}
			</div>
			@chatMetaStrip(e)
		</div>
	</div>
}

templ chatReasoningBlock(e views.EventSummary) {
	<div id={ e.EventUID } class="mr-auto max-w-[95%] sm:max-w-[85%] ml-8 border-l-4 border-amber-500/40">
		<details>
			<summary class="text-gray-500 text-sm cursor-pointer flex items-center gap-2 py-1.5 px-2 hover:bg-gray-800/30 rounded transition-colors">
				<svg class="w-4 h-4 flex-shrink-0 text-amber-500/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
				</svg>
				<span>Thinking</span>
				if e.Tokens > 0 {
					<span class="text-xs text-gray-600">{ fmt.Sprintf("%d tok", e.Tokens) }</span>
				}
			</summary>
			@truncatableBlock("#111827") {
				<div class="text-gray-400 text-sm italic whitespace-pre-wrap mt-2 px-2 pb-1">
					{ chatDisplayText(e) }
				</div>
			}
		</details>
	</div>
}

templ chatToolChain(items []views.ToolChainItem) {
	<div class="mr-auto max-w-[95%] sm:max-w-[85%] ml-8 my-2">
		<details class="group/chain border border-gray-700/50 rounded-lg bg-gray-800/30">
			<summary class="text-sm cursor-pointer flex items-center gap-2 py-2 px-3 hover:bg-gray-800/50 rounded-lg transition-colors">
				<svg class="w-3.5 h-3.5 text-yellow-400 flex-shrink-0 transition-transform group-open/chain:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
				</svg>
				<svg class="w-4 h-4 text-yellow-400/70 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
				</svg>
				<span class="text-yellow-400/80 font-medium">Tool Use</span>
				<span class="text-gray-500 text-xs">{ fmt.Sprintf("%d %s", len(items), toolCallPlural(len(items))) }</span>
				@toolChainNameList(items)
			</summary>
			<div class="border-t border-gray-700/30 pl-4 border-l-4 border-yellow-400/40 ml-3 space-y-1 py-2">
				for _, item := range items {
					@chatToolItem(item)
				}
			</div>
		</details>
	</div>
}

templ chatToolItem(item views.ToolChainItem) {
	<details id={ item.CallEvent.EventUID } class="group/tool">
		<summary class="text-sm cursor-pointer flex items-center gap-2 py-1 hover:bg-gray-800/50 rounded px-2 -ml-2 transition-colors">
			<svg class="w-3.5 h-3.5 text-yellow-400 flex-shrink-0 transition-transform group-open/tool:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
			</svg>
			<span class="text-yellow-400 font-medium truncate">{ toolDisplayName(item.ToolName) }</span>
			if models.IsMCPTool(item.ToolName) {
				<span class="px-1.5 py-0.5 text-xs rounded bg-cyan-500/20 text-cyan-400 flex-shrink-0">MCP</span>
			}
			if item.ResultEvent != nil {
				<span class="text-green-500/60 text-xs flex-shrink-0">&#x2713;</span>
			} else {
				<span class="text-amber-500/60 text-xs flex-shrink-0" title="No result received">&#x26A0;</span>
			}
			if item.CallEvent.DurationMs > 0 {
				<span class="text-gray-600 text-xs flex-shrink-0">{ fmt.Sprintf("%dms", item.CallEvent.DurationMs) }</span>
			}
		</summary>
		<div class="mt-2 ml-5">
			if item.Params != nil && item.ToolName == "Bash" {
				@toolCardBash(item)
			} else if item.Params != nil && item.ToolName == "Edit" {
				@toolCardEdit(item)
			} else if item.Params != nil && item.ToolName == "Write" {
				@toolCardWrite(item)
			} else if item.Params != nil && item.ToolName == "Read" {
				@toolCardRead(item)
			} else if item.Params != nil && (item.ToolName == "Grep" || item.ToolName == "Glob") {
				@toolCardSearch(item)
			} else {
				@toolCardGeneric(item)
			}
		</div>
	</details>
}

templ toolChainNameList(items []views.ToolChainItem) {
	<span class="text-gray-600 text-xs truncate">
		for i, item := range items {
			if i > 0 {
				{ ", " }
			}
			if i < 5 {
				{ toolDisplayName(item.ToolName) }
			}
		}
		if len(items) > 5 {
			{ fmt.Sprintf(" +%d more", len(items)-5) }
		}
	</span>
}

templ chatErrorBlock(e views.EventSummary) {
	<div id={ e.EventUID } class="bg-red-500/10 border border-red-500/30 border-l-4 border-l-red-400 rounded-lg px-4 py-3 mr-auto max-w-[95%] sm:max-w-[85%] ml-8">
		<div class="flex items-start gap-2">
			<svg class="w-4 h-4 text-red-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
			</svg>
			<p class="text-red-300 text-sm break-words">{ chatDisplayText(e) }</p>
		</div>
	</div>
}

templ chatMetaStrip(e views.EventSummary) {
	if e.Model != "" || e.Tokens > 0 || e.DurationMs > 0 {
		<div class="chat-meta-strip text-xs text-gray-500 mt-1.5 flex items-center gap-2">
			if e.Model != "" {
				<span class="px-1.5 py-0.5 rounded bg-gray-800/50 text-gray-400">{ e.Model }</span>
			}
			if e.Tokens > 0 {
				<span>{ fmt.Sprintf("%d tok", e.Tokens) }</span>
			}
			if e.DurationMs > 0 {
				<span>{ fmt.Sprintf("%dms", e.DurationMs) }</span>
			}
		</div>
	}
}

templ toolCardBash(item views.ToolChainItem) {
	<div class="space-y-2">
		if item.Params.Description != "" {
			<p class="text-xs text-gray-400 italic">{ item.Params.Description }</p>
		}
		<div class="code-container relative group">
			<div class="flex items-center gap-2 px-3 py-1.5 bg-gray-900 border border-gray-800 rounded-t-lg text-xs text-gray-500">
				<span class="text-green-400 font-mono">$</span>
				<span class="text-gray-400">bash</span>
			</div>
			<pre class="bg-gray-950 rounded-b-lg p-3 text-xs text-gray-200 font-mono overflow-x-auto border-x border-b border-gray-800"><code class="language-bash">{ item.Params.Command }</code></pre>
			@copyButton()
		</div>
		if item.OutputPreview != "" {
			<div>
				<p class="text-xs text-gray-500 mb-1 font-medium uppercase tracking-wide">Output</p>
				@truncatableBlock("#111827") {
					<pre class="bg-gray-900 rounded-lg p-3 text-xs text-gray-300 font-mono overflow-x-auto border border-gray-800">{ views.CleanSystemTags(item.OutputPreview) }</pre>
				}
			</div>
		}
	</div>
}

templ toolCardEdit(item views.ToolChainItem) {
	<div class="space-y-2">
		if item.Params.FilePath != "" {
			<div class="flex items-center gap-2 text-xs min-w-0">
				<svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
				</svg>
				<span class="px-2 py-0.5 bg-gray-800 rounded text-gray-300 font-mono tool-filepath" title={ item.Params.FilePath }>{ item.Params.FilePath }</span>
			</div>
		}
		if item.Params.OldString != "" {
			<div class="code-container relative">
				<pre class="bg-red-500/10 rounded-lg p-3 text-xs text-red-300 font-mono overflow-x-auto border border-red-500/20"><code>{ item.Params.OldString }</code></pre>
			</div>
		}
		if item.Params.NewString != "" {
			<div class="code-container relative">
				<pre class="bg-green-500/10 rounded-lg p-3 text-xs text-green-300 font-mono overflow-x-auto border border-green-500/20"><code>{ item.Params.NewString }</code></pre>
			</div>
		}
	</div>
}

templ toolCardWrite(item views.ToolChainItem) {
	<div class="space-y-2">
		if item.Params.FilePath != "" {
			<div class="flex items-center gap-2 text-xs min-w-0">
				<svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
				</svg>
				<span class="px-2 py-0.5 bg-gray-800 rounded text-gray-300 font-mono tool-filepath" title={ item.Params.FilePath }>{ item.Params.FilePath }</span>
			</div>
		}
		if item.Params.Content != "" {
			@truncatableBlock("#111827") {
				<div class="code-container relative group">
					<pre class="bg-gray-900 rounded-lg p-3 text-xs text-gray-300 font-mono overflow-x-auto border border-gray-800"><code>{ item.Params.Content }</code></pre>
					@copyButton()
				</div>
			}
		}
	</div>
}

templ toolCardRead(item views.ToolChainItem) {
	<div class="space-y-2">
		if item.Params.FilePath != "" {
			<div class="flex items-center gap-2 text-xs min-w-0">
				<svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
				</svg>
				<span class="px-2 py-0.5 bg-gray-800 rounded text-gray-300 font-mono tool-filepath" title={ item.Params.FilePath }>{ item.Params.FilePath }</span>
			</div>
		}
		if item.OutputPreview != "" {
			@truncatableBlock("#111827") {
				<pre class="bg-gray-900 rounded-lg p-3 text-xs text-gray-300 font-mono overflow-x-auto border border-gray-800">{ item.OutputPreview }</pre>
			}
		}
	</div>
}

templ toolCardSearch(item views.ToolChainItem) {
	<div class="space-y-2">
		<div class="flex items-center gap-2 text-xs">
			<svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
			</svg>
			if item.Params.Pattern != "" {
				<span class="px-2 py-0.5 bg-gray-800 rounded text-yellow-300 font-mono">{ item.Params.Pattern }</span>
			}
			if item.Params.Path != "" {
				<span class="text-gray-500">in</span>
				<span class="text-gray-400 font-mono">{ item.Params.Path }</span>
			}
		</div>
		if item.OutputPreview != "" {
			@truncatableBlock("#111827") {
				<pre class="bg-gray-900 rounded-lg p-3 text-xs text-gray-300 font-mono overflow-x-auto border border-gray-800">{ item.OutputPreview }</pre>
			}
		}
	</div>
}

templ toolCardGeneric(item views.ToolChainItem) {
	<div class="space-y-2">
		if item.InputPreview != "" {
			<div>
				<p class="text-xs text-gray-500 mb-1 font-medium uppercase tracking-wide">Input</p>
				<pre class="bg-gray-900 rounded-lg p-3 text-xs text-gray-300 font-mono overflow-x-auto border border-gray-800"><code class="language-json">{ item.InputPreview }</code></pre>
			</div>
		}
		if item.OutputPreview != "" {
			<div>
				<p class="text-xs text-gray-500 mb-1 font-medium uppercase tracking-wide">Output</p>
				@truncatableBlock("#111827") {
					<pre class="bg-gray-900 rounded-lg p-3 text-xs text-gray-300 font-mono overflow-x-auto border border-gray-800">{ item.OutputPreview }</pre>
				}
			</div>
		}
		if item.InputPreview == "" && item.OutputPreview == "" {
			<p class="text-xs text-gray-600 italic">No preview available</p>
		}
	</div>
}

templ copyButton() {
	<button onclick="copyToClipboard(this)"
			class="absolute top-2 right-2 p-1 rounded bg-gray-700/50 hover:bg-gray-600/50 text-gray-400 hover:text-gray-200 transition-colors opacity-0 group-hover:opacity-100"
			title="Copy to clipboard">
		<svg class="w-3.5 h-3.5 copy-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
		</svg>
		<svg class="w-3.5 h-3.5 check-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
		</svg>
	</button>
}

func toolDisplayName(name string) string {
	if name == "" {
		return "tool"
	}
	return name
}

func toolCallPlural(n int) string {
	if n == 1 {
		return "call"
	}
	return "calls"
}

func chatDisplayText(e views.EventSummary) string {
	if e.TextContent != "" {
		return e.TextContent
	}
	return e.TextPreview
}

func chatCleanUserText(e views.EventSummary) string {
	return views.CleanSystemTags(chatDisplayText(e))
}

templ truncatableBlock(fadeBg string) {
	<div class="truncatable" style={ "--fade-bg: " + fadeBg }>
		<div class="truncatable-content">
			{ children... }
		</div>
		<div class="truncatable-fade"></div>
		<button class="truncate-toggle" onclick="toggleTruncation(this.closest('.truncatable'))">Show more</button>
	</div>
}
