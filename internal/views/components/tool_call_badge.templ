package components

import "github.com/technodrome-ai/technodrome/internal/views"

templ ToolCallBadge(tc views.ToolCallInfo) {
	<span class={
		"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium border",
		templ.KV("bg-green-500/10 text-green-400 border-green-500/30", tc.Status == "success"),
		templ.KV("bg-red-500/10 text-red-400 border-red-500/30", tc.Status == "error"),
	}>
		<span class={
			"w-1.5 h-1.5 rounded-full",
			templ.KV("bg-green-400", tc.Status == "success"),
			templ.KV("bg-red-400", tc.Status == "error"),
		}></span>
		{ tc.Name }
		if tc.Duration != "" {
			<span class="text-gray-500">{ tc.Duration }</span>
		}
	</span>
}
