package components

import (
	"fmt"
	"github.com/johnnygreco/beacon/internal/views"
)

templ SessionCard(s views.SessionSummary) {
	<a href={ templ.SafeURL(fmt.Sprintf("/sessions/%s", s.ID)) } class="block bg-gray-800 rounded-lg p-4 border border-gray-700 hover:border-blue-500/70 hover:shadow-lg hover:shadow-blue-500/5 transition-all cursor-pointer">
		<div class="flex items-center justify-between mb-1">
			<span class="font-medium text-gray-100 truncate">{ views.SessionTitle(s, false) }</span>
			if s.Status == "active" {
				<span class="px-2 py-0.5 text-xs font-semibold uppercase rounded-full bg-green-500/20 text-green-400">Active</span>
			} else if s.Status == "idle" {
				<span class="px-2 py-0.5 text-xs font-semibold uppercase rounded-full bg-amber-500/20 text-amber-400">Idle</span>
			} else {
				<span class="px-2 py-0.5 text-xs font-semibold uppercase rounded-full bg-gray-600/40 text-gray-400">Done</span>
			}
		</div>
		if s.WorkingDir != "" {
			<p class="text-xs text-gray-500 truncate" title={ s.WorkingDir }>{ s.WorkingDir }</p>
		}
		<div class="flex items-center gap-2 mb-2">
			if s.ActiveModel != "" {
				<span class="text-xs text-gray-500 truncate">{ s.ActiveModel }</span>
			}
			<span class="text-xs text-gray-600 font-mono">{ views.TruncateID(s.ID) }</span>
		</div>
		<div class="grid grid-cols-2 gap-2 text-xs text-gray-400 mt-2">
			<div>
				<span class="text-gray-500">Duration</span>
				<p class="text-gray-300">{ s.Duration }</p>
			</div>
			<div>
				<span class="text-gray-500">Tokens</span>
				<p class="text-gray-300">{ views.FormatTokens(s.TotalTokens) }</p>
			</div>
			<div>
				<span class="text-gray-500">Turns</span>
				<p class="text-gray-300">{ fmt.Sprintf("%d", s.TurnCount) }</p>
			</div>
			<div>
				<span class="text-gray-500">Tool Calls</span>
				<p class="text-gray-300">{ fmt.Sprintf("%d", s.ToolCallCount) }</p>
			</div>
		</div>
	</a>
}

templ ActiveSessionCard(s views.SessionSummary) {
	if s.IsSubagent() {
		@orphanSubagentCard(s)
	} else {
		@parentActiveCard(s)
	}
}

templ parentActiveCard(s views.SessionSummary) {
	<div class={ "rounded-lg overflow-hidden bg-gray-800/60 border-l-2", templ.KV("border-green-500/50", s.Status == "active"), templ.KV("border-amber-500/40", s.Status == "idle") }>
		<a href={ templ.SafeURL(fmt.Sprintf("/sessions/%s", s.ID)) } class="block px-4 py-3 hover:bg-gray-700/20 transition-colors">
			<div class="flex items-center justify-between">
				<div class="flex items-center gap-2 min-w-0">
					if s.Status == "active" {
						<span class="relative flex h-2 w-2 flex-shrink-0">
							<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
							<span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
						</span>
					} else {
						<span class="relative flex h-2 w-2 flex-shrink-0">
							<span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500/60"></span>
						</span>
					}
					<span class="font-medium text-gray-100 truncate">{ views.SessionTitle(s, false) }</span>
					<span class="text-xs text-gray-600 font-mono flex-shrink-0">{ views.TruncateID(s.ID) }</span>
				</div>
				<div class="flex items-center gap-1.5 flex-shrink-0 ml-2">
					@providerBadge(s.Provider)
					if s.Status == "active" {
						<span class="px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide rounded bg-green-500/15 text-green-400">Live</span>
					} else {
						<span class="px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide rounded bg-amber-500/15 text-amber-400">Idle</span>
					}
				</div>
			</div>
			<div class="flex items-center gap-2 text-xs text-gray-500 mt-1 ml-4 flex-wrap">
				if s.ActiveModel != "" {
					<span class="px-1.5 py-0.5 rounded bg-gray-700/80 text-gray-300">{ views.ShortModelName(s.ActiveModel) }</span>
				}
				<span>{ s.Duration }</span>
				<span class="text-gray-700">·</span>
				<span>{ fmt.Sprintf("%d turns", s.TurnCount) }</span>
				<span class="text-gray-700">·</span>
				<span>{ views.FormatTokens(s.TotalTokens) } tok</span>
				<span class="text-gray-700">·</span>
				<span>{ fmt.Sprintf("%d tools", s.ToolCallCount) }</span>
			</div>
			if s.WorkingDir != "" {
				<p class="text-[11px] text-gray-600 truncate mt-0.5 ml-4" title={ s.WorkingDir }>{ s.WorkingDir }</p>
			}
		</a>
		if len(s.ChildSessions) > 0 {
			<div class="border-t border-gray-700/30 px-4 py-2">
				<div class="text-[10px] uppercase tracking-wider text-blue-400/50 mb-1">
					{ views.Pluralize(len(s.ChildSessions), "subagent") }
				</div>
				for _, child := range s.ChildSessions {
					<a href={ templ.SafeURL(fmt.Sprintf("/sessions/%s", child.ID)) }
					   class="flex items-center gap-2 text-xs py-1 px-2 -mx-1 rounded hover:bg-gray-700/30 transition-colors">
						<span class="w-1.5 h-1.5 rounded-full bg-blue-400/50 flex-shrink-0"></span>
						<span class="text-gray-500 font-mono flex-shrink-0">{ views.TruncateID(child.ID) }</span>
						if child.ActiveModel != "" {
							<span class="text-gray-400 truncate flex-shrink-0">{ views.ShortModelName(child.ActiveModel) }</span>
						}
						<span class="ml-auto flex items-center text-gray-500 tabular-nums flex-shrink-0">
							<span class="w-14 text-right">{ child.Duration }</span>
							<span class="w-12 text-right">{ views.FormatTokens(child.TotalTokens) }</span>
							<span class="w-8 text-right">{ fmt.Sprintf("%dt", child.ToolCallCount) }</span>
						</span>
					</a>
				}
			</div>
		}
	</div>
}

templ orphanSubagentCard(s views.SessionSummary) {
	<a href={ templ.SafeURL(fmt.Sprintf("/sessions/%s", s.ID)) } class={ "block rounded-lg overflow-hidden bg-gray-800/40 border-l-2 px-4 py-3 hover:bg-gray-700/20 transition-colors", templ.KV("border-blue-500/50", s.Status == "active"), templ.KV("border-amber-500/40", s.Status == "idle") }>
		<div class="flex items-center justify-between">
			<div class="flex items-center gap-2 min-w-0">
				if s.Status == "active" {
					<span class="relative flex h-2 w-2 flex-shrink-0">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
						<span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
					</span>
				} else {
					<span class="relative flex h-2 w-2 flex-shrink-0">
						<span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500/60"></span>
					</span>
				}
				<span class="font-medium text-gray-100 truncate">{ views.SessionTitle(s, false) }</span>
				<span class="text-xs text-gray-600 font-mono flex-shrink-0">{ views.TruncateID(s.ID) }</span>
			</div>
			if s.Status == "active" {
				<span class="px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide rounded bg-blue-500/15 text-blue-400 flex-shrink-0 ml-2">Sub</span>
			} else {
				<span class="px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide rounded bg-amber-500/15 text-amber-400 flex-shrink-0 ml-2">Idle</span>
			}
		</div>
		<div class="flex items-center gap-2 text-xs text-gray-500 mt-1 ml-4 flex-wrap">
			<span class="text-blue-400/50">↑ { views.TruncateID(s.ParentSessionID) }</span>
			if s.ActiveModel != "" {
				<span class="px-1.5 py-0.5 rounded bg-gray-700/80 text-gray-300">{ views.ShortModelName(s.ActiveModel) }</span>
			}
			<span>{ s.Duration }</span>
			<span class="text-gray-700">·</span>
			<span>{ views.FormatTokens(s.TotalTokens) } tok</span>
			<span class="text-gray-700">·</span>
			<span>{ fmt.Sprintf("%d tools", s.ToolCallCount) }</span>
		</div>
	</a>
}

templ SubagentSessionCard(s views.SessionSummary) {
	<a href={ templ.SafeURL(fmt.Sprintf("/sessions/%s", s.ID)) } class="block bg-gray-900 rounded-lg p-4 border border-blue-500/20 hover:border-blue-400/50 hover:shadow-lg hover:shadow-blue-500/5 transition-all cursor-pointer">
		<div class="flex items-center justify-between mb-2">
			<div class="flex items-center gap-2">
				<svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
				</svg>
				<span class="font-medium text-gray-200 text-sm truncate">{ views.SessionTitle(s, false) }</span>
			</div>
			if s.Status == "active" {
				<span class="px-1.5 py-0.5 text-xs font-semibold uppercase rounded-full bg-blue-500/20 text-blue-400">Live</span>
			} else if s.Status == "idle" {
				<span class="px-1.5 py-0.5 text-xs font-semibold uppercase rounded-full bg-amber-500/20 text-amber-400">Idle</span>
			} else {
				<span class="px-1.5 py-0.5 text-xs font-semibold uppercase rounded-full bg-gray-600/40 text-gray-500">Done</span>
			}
		</div>
		<div class="flex items-center gap-2 mb-2">
			if s.ActiveModel != "" {
				<span class="px-1.5 py-0.5 rounded bg-gray-800 text-gray-400 text-xs">{ s.ActiveModel }</span>
			}
			<span class="text-xs text-gray-600 font-mono">{ views.TruncateID(s.ID) }</span>
		</div>
		<div class="grid grid-cols-4 gap-2 text-xs text-gray-500">
			<div>
				<span class="text-gray-600">Duration</span>
				<p class="text-gray-400">{ s.Duration }</p>
			</div>
			<div>
				<span class="text-gray-600">Tokens</span>
				<p class="text-gray-400">{ views.FormatTokens(s.TotalTokens) }</p>
			</div>
			<div>
				<span class="text-gray-600">Turns</span>
				<p class="text-gray-400">{ fmt.Sprintf("%d", s.TurnCount) }</p>
			</div>
			<div>
				<span class="text-gray-600">Tools</span>
				<p class="text-gray-400">{ fmt.Sprintf("%d", s.ToolCallCount) }</p>
			</div>
		</div>
	</a>
}

templ providerBadge(provider string) {
	if provider == "openai" {
		<span class="px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide rounded bg-emerald-500/15 text-emerald-400" title="Codex (OpenAI)">{ views.ProviderShort(provider) }</span>
	} else if provider == "anthropic" {
		<span class="px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide rounded bg-orange-500/15 text-orange-300" title="Claude Code (Anthropic)">{ views.ProviderShort(provider) }</span>
	} else if provider != "" {
		<span class="px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide rounded bg-gray-500/15 text-gray-400" title={ provider }>{ views.ProviderShort(provider) }</span>
	}
}

script goToSession(url string) {
	window.location.href = url
}

templ CompletedSessionRow(s views.SessionSummary) {
	<tr onclick={ goToSession(fmt.Sprintf("/sessions/%s", s.ID)) }
		class="border-b border-gray-800/50 cursor-pointer transition-colors"
		id={ "session-row-" + s.ID }
		data-sort-name={ views.SessionTitle(s, false) }
		data-sort-provider={ views.ProviderShort(s.Provider) }
		data-sort-model={ s.ActiveModel }
		data-sort-tokens={ fmt.Sprintf("%d", s.TotalTokens) }
		data-sort-turns={ fmt.Sprintf("%d", s.TurnCount) }
		data-sort-tools={ fmt.Sprintf("%d", s.ToolCallCount) }
		data-sort-duration={ fmt.Sprintf("%d", s.DurationSeconds()) }
		data-sort-project={ s.WorkingDir }
		data-sort-ended={ fmt.Sprintf("%d", s.EndedAt.Unix()) }>
		<td class="py-2 px-3 text-sm text-gray-300 whitespace-nowrap">
			<span class="inline-flex items-center gap-1.5">
				if s.SubagentCount > 0 {
					<button
						type="button"
						class="subagent-toggle text-gray-500 hover:text-gray-300 transition-colors flex-shrink-0"
						onclick={ toggleSubagents(s.ID) }
						title={ fmt.Sprintf("%d subagents", s.SubagentCount) }
					>
						<svg class="w-3.5 h-3.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
						</svg>
					</button>
				}
				<span>{ views.SessionTitle(s, false) }</span>
				if s.SubagentCount > 0 {
					<span class="text-[10px] text-blue-400/60 font-normal">{ fmt.Sprintf("+%d sub", s.SubagentCount) }</span>
				}
			</span>
		</td>
		<td class="py-2 px-3 text-xs whitespace-nowrap">
			@providerBadge(s.Provider)
		</td>
		<td class="py-2 px-3 text-xs text-gray-400">
			if s.ActiveModel != "" {
				{ views.ShortModelName(s.ActiveModel) }
			}
		</td>
		<td class="py-2 px-3 text-right text-xs text-gray-400 tabular-nums">{ views.FormatTokens(s.TotalTokens) }</td>
		<td class="py-2 px-3 text-right text-xs text-gray-400 tabular-nums">{ fmt.Sprintf("%d", s.TurnCount) }</td>
		<td class="py-2 px-3 text-right text-xs text-gray-400 tabular-nums">{ fmt.Sprintf("%d", s.ToolCallCount) }</td>
		<td class="py-2 px-3 text-right text-xs text-gray-400 tabular-nums whitespace-nowrap">{ s.Duration }</td>
		<td class="py-2 px-3 text-xs text-gray-500 max-w-[180px] truncate" title={ s.WorkingDir }>{ s.WorkingDir }</td>
		<td class="py-2 px-3 text-right text-xs text-gray-500 tabular-nums whitespace-nowrap">{ views.RelativeTime(s.EndedAt) }</td>
	</tr>
}

script toggleSubagents(sessionID string) {
	event.stopPropagation();
	var parentRow = document.getElementById('session-row-' + sessionID);
	if (!parentRow) return;
	var btn = parentRow.querySelector('.subagent-toggle');
	var existing = parentRow.parentNode.querySelectorAll('tr[data-parent="' + sessionID + '"]');
	if (existing.length > 0) {
		// Toggle visibility
		var hidden = existing[0].classList.contains('hidden');
		existing.forEach(function(row) {
			row.classList.toggle('hidden');
		});
		btn.querySelector('svg').style.transform = hidden ? 'rotate(90deg)' : '';
	} else {
		// Fetch subagent rows (event implicit from onclick handler)
		btn.querySelector('svg').style.transform = 'rotate(90deg)';
		fetch('/dashboard/sessions/' + sessionID + '/subagents')
			.then(function(res) { return res.text(); })
			.then(function(html) {
				if (html.trim()) {
					parentRow.insertAdjacentHTML('afterend', html);
				}
			})
			.catch(function() {
				btn.querySelector('svg').style.transform = '';
			});
	}
}

templ CompletedSubagentRow(s views.SessionSummary, parentID string) {
	<tr data-parent={ parentID }
		onclick={ goToSession(fmt.Sprintf("/sessions/%s", s.ID)) }
		class="border-b border-gray-800/50 cursor-pointer transition-colors bg-gray-800/20">
		<td class="py-1.5 px-3 text-sm text-gray-400 whitespace-nowrap pl-10">
			<span class="inline-flex items-center gap-1.5">
				<span class="w-1.5 h-1.5 rounded-full bg-blue-400/50 flex-shrink-0"></span>
				<span class="text-blue-400/70 text-xs">sub</span>
				<span>{ views.SessionTitle(s, false) }</span>
			</span>
		</td>
		<td class="py-1.5 px-3 text-xs text-gray-600"></td>
		<td class="py-1.5 px-3 text-xs text-gray-500">
			if s.ActiveModel != "" {
				{ views.ShortModelName(s.ActiveModel) }
			}
		</td>
		<td class="py-1.5 px-3 text-right text-xs text-gray-500 tabular-nums">{ views.FormatTokens(s.TotalTokens) }</td>
		<td class="py-1.5 px-3 text-right text-xs text-gray-500 tabular-nums">{ fmt.Sprintf("%d", s.TurnCount) }</td>
		<td class="py-1.5 px-3 text-right text-xs text-gray-500 tabular-nums">{ fmt.Sprintf("%d", s.ToolCallCount) }</td>
		<td class="py-1.5 px-3 text-right text-xs text-gray-500 tabular-nums whitespace-nowrap">{ s.Duration }</td>
		<td class="py-1.5 px-3 text-xs text-gray-600 max-w-[180px] truncate" title={ s.WorkingDir }>{ s.WorkingDir }</td>
		<td class="py-1.5 px-3 text-right text-xs text-gray-600 tabular-nums whitespace-nowrap">{ views.RelativeTime(s.EndedAt) }</td>
	</tr>
}



