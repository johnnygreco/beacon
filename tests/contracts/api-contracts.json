  "ModelSeriesDataset": {
    "required": {
      "label": "string",
      "model": "string",
      "provider": "string",
      "provider_label": "string",
      "values": "number[]"
    },
    "optional": {
      "total_tokens": "integer",
      "input_tokens": "integer",
      "output_tokens": "integer",
      "cache_read_tokens": "integer",
      "tool_call_count": "integer",
      "call_count": "integer",
      "error_count": "integer"
    }
  },
  "ModelAnalyticsSummary": {
    "required": {
      "total_tokens": "integer",
