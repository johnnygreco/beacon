      "tool_name": "string",
      "provider": "string",
      "model": "string",
      "score": "number",
      "session_title": "string",
      "working_dir": "string"
    }
  },
  "APIDashboardSearchResponse": {
    "required": {
      "state": "string",
      "sort": "string",
      "limit": "integer",
      "has_more": "boolean",
