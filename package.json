{
  "name": "beacon",
  "version": "0.0.0-dev",
  "private": true,
  "description": "Live dashboard for AI coding agent sessions.",
  "scripts": {
    "vendor": "node scripts/vendor-assets.mjs",
    "vendor:check": "node scripts/vendor-assets.mjs --check",
    "lint:js": "eslint static/js tests/js --max-warnings=0",
    "test:unit": "node --test tests/js/*.test.cjs",
    "test:frontend": "npm run lint:js && npm run test:unit",
    "test:e2e": "playwright test tests/e2e/dashboard.spec.ts tests/e2e/dashboard-search.spec.ts",
    "test:e2e:search": "playwright test tests/e2e/dashboard-search.spec.ts",
    "test:perf:browser": "playwright test tests/e2e/performance.spec.ts --reporter=line",
    "test:search": "npm run test:e2e:search",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:visual": "playwright test tests/e2e/visual.spec.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnnygreco/beacon.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/johnnygreco/beacon/issues"
  },
  "homepage": "https://github.com/johnnygreco/beacon#readme",
  "devDependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "@playwright/test": "^1.59.1",
    "axe-core": "^4.11.4",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.1.0",
    "eslint": "^10.4.0",
    "htmx-ext-sse": "^2.2.4",
    "htmx.org": "^2.0.10"
  }
}
